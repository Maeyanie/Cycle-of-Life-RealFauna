    "ceratopsidae:ceratopsidae-styracosaurus-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-sinoceratops-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-xenoceratops-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-machairoceratops-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-regaliceratops-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-nasutoceratops-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-leptoceratops-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-protoceratops-incubating": { "chainSeed": true },
    "ceratopsidae:ceratopsidae-ajkaceratops-incubating": { "chainSeed": true }

  }
}
