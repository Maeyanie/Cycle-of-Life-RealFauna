// Cycle of Life: Realistic Fauna - Legacy of the Phanerozoic: Fused Body (ankylosauria).
//
// Eight ankylosaurs, from a 6 tonne Ankylosaurus down to a 250 kg Struthiosaurus, plus their nests.
// Same authors and shape as the other Legacy of the Phanerozoic files, and the same two jobs as the
// pachycephalosaurs: give them food, and give them believable sizes.
//
// 1. THEY EAT NOTHING AS SHIPPED - identical to the Domed Head mod. creatureDiet declares an EMPTY
//    foodCategories list and a single "fruitmash" tag, and plant food tags are deliberately not
//    mapped onto forage categories, so it resolves to nothing at all. Eight herbivores that are
//    neither predator nor forager, drawing on no food supply and bounded only by carrying capacity
//    and old age.
//
//    Given Vegetable + Fruit, with VEGETABLE LEADING here, which is the opposite emphasis to the
//    pachycephalosaurs. Ankylosaurs are the rare dinosaurs whose diet is known directly rather than
//    inferred: the Borealopelta specimen preserved its last meal, and it was overwhelmingly ferns,
//    with charcoal mixed in suggesting it had been feeding on regrowth after a fire. Low browsers of
//    soft ground vegetation, in other words, not fruit specialists - but the mod own tag is
//    fruitmash, so Fruit stays as the secondary.
//
// 2. BODY WEIGHT, DECLARED AS A FLAT 4000 kg FOR EVERY ADULT. That figure is at least in the right
//    postcode for this family - unusually, since the same 4000 covers cat-sized pachycephalosaurs in
//    the sibling mod - but it is still low for Ankylosaurus and sixteenfold too heavy for
//    Struthiosaurus. Published estimates per species below.
//
// 3. ARMOUR IS THE INTERESTING VARIABLE, and it is what predationVulnerability is for. This family
//    splits two ways, and the split is worth respecting:
//
//      ANKYLOSAURIDS (Ankylosaurus, Tarchia, Euoplocephalus, Ziapelta, Pinacosaurus) carry the bone-
//      breaking TAIL CLUB and get the lowest vulnerabilities in the entire pack. An adult
//      Ankylosaurus at 0.03 is very nearly unkillable, which is correct: it is the whole animal.
//
//      NODOSAURIDS (Edmontonia, Antarctopelta, Struthiosaurus) have no club. Edmontonia substitutes
//      enormous forward shoulder spikes, which is defence by threat and frontage rather than by
//      counter-attack, so it is rated somewhat easier to kill at similar mass. Struthiosaurus, small
//      and clubless, is the only member of the family that reads as prey.
//
// NESTS ARE CHAIN SEEDS, as in the sibling files - "bellalarm" beside "idle" fails the static test,
// so without this they would be managed as breeding animals. Only INCUBATING nests need entries;
// mature and empty get triesPerChunk 0, and eggs are runtime chance 0.0.
//
// VERIFICATION STATUS: keys derived from the mod own entity JSON, not read off a live roster - this
// mod is not installed on the pack author server. A wrong key is inert (the entry is ignored and the
// animal keeps its auto-discovered values); `/col species` lists the authoritative keys.
{
  "species": {


    // Ankylosaurus - 4.8 to 8 tonnes, the largest and last of the family, and the one with the
    // textbook tail club. Predation vulnerability is the lowest in this pack: an adult with a club
    // capable of breaking bone is very close to unkillable, which is the whole point of the animal.
    "ankylosauria:ankylosauria-ankylosaurus": {
      "carryingCapacity": 1, "bodyWeight": 6000,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.08, "predationVulnerability": 0.03,
      "lifecycle": { "lifespanDays": 13000, "gestationDays": 70, "litterSizeMin": 3, "litterSizeMax": 8, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // Tarchia - around 3 tonnes, the largest Asian ankylosaurid, and also club-tailed.
    "ankylosauria:ankylosauria-tarchia": {
      "carryingCapacity": 1, "bodyWeight": 3000,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.09, "predationVulnerability": 0.04,
      "lifecycle": { "lifespanDays": 12000, "gestationDays": 70, "litterSizeMin": 3, "litterSizeMax": 8, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // Edmontonia - about 2.8 tonnes, and a NODOSAURID: no tail club at all, but huge forward-pointing
    // shoulder spikes. Defence by threat and frontage rather than by counter-attack, so it is rated a
    // little easier to kill than the club-bearers despite similar mass.
    "ankylosauria:ankylosauria-edmontonia": {
      "carryingCapacity": 2, "bodyWeight": 2800,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.1, "predationVulnerability": 0.08,
      "lifecycle": { "lifespanDays": 11000, "gestationDays": 70, "litterSizeMin": 3, "litterSizeMax": 8, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // Euoplocephalus - roughly 2.5 tonnes, club-tailed, and armoured even to bony eyelids.
    "ankylosauria:ankylosauria-euoplocephalus": {
      "carryingCapacity": 2, "bodyWeight": 2500,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.1, "predationVulnerability": 0.04,
      "lifecycle": { "lifespanDays": 11000, "gestationDays": 70, "litterSizeMin": 3, "litterSizeMax": 8, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // Ziapelta - about 2 tonnes, named in 2014 from a well-preserved skull, and club-tailed.
    "ankylosauria:ankylosauria-ziapelta": {
      "carryingCapacity": 2, "bodyWeight": 2000,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.11, "predationVulnerability": 0.05,
      "lifecycle": { "lifespanDays": 10000, "gestationDays": 70, "litterSizeMin": 3, "litterSizeMax": 8, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // Pinacosaurus - roughly 1.9 tonnes. Known from groups of juveniles buried together, which is some
    // of the better evidence that young ankylosaurs stayed in company.
    "ankylosauria:ankylosauria-pinacosaurus": {
      "carryingCapacity": 2, "bodyWeight": 1900,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.12, "predationVulnerability": 0.06,
      "lifecycle": { "lifespanDays": 10000, "gestationDays": 70, "litterSizeMin": 4, "litterSizeMax": 8, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // Antarctopelta - around 900 kg, the first dinosaur found in Antarctica, and a nodosaurid, so no
    // club. Estimates run wide on fragmentary material.
    "ankylosauria:ankylosauria-antarctopelta": {
      "carryingCapacity": 3, "bodyWeight": 900,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.15, "predationVulnerability": 0.15,
      "lifecycle": { "lifespanDays": 9000, "gestationDays": 70, "litterSizeMin": 4, "litterSizeMax": 8, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // Struthiosaurus - about 250 kg and the smallest ankylosaur known, an island dwarf from the
    // European archipelago of the Late Cretaceous. Small, clubless and genuinely catchable, so it is
    // the one member of the family that reads as prey rather than as a walking fortress.
    "ankylosauria:ankylosauria-struthiosaurus": {
      "carryingCapacity": 3, "bodyWeight": 250,
      "isForager": true, "foodCategories": ["Vegetable", "Fruit"],
      "growthRate": 0.2, "predationVulnerability": 0.3,
      "lifecycle": { "lifespanDays": 7200, "gestationDays": 70, "litterSizeMin": 4, "litterSizeMax": 9, "breedingMonths": [4, 5], "juvenileMortality": 0.8 }
    },

    // ===================== NESTS (chain seeds) =====================
    // Observed, never spawn-controlled. The mod own chain decides how many there are.
    "ankylosauria:ankylosauria-ankylosaurus-incubating": { "chainSeed": true },
    "ankylosauria:ankylosauria-tarchia-incubating": { "chainSeed": true },
    "ankylosauria:ankylosauria-edmontonia-incubating": { "chainSeed": true },
    "ankylosauria:ankylosauria-euoplocephalus-incubating": { "chainSeed": true },
    "ankylosauria:ankylosauria-ziapelta-incubating": { "chainSeed": true },
    "ankylosauria:ankylosauria-pinacosaurus-incubating": { "chainSeed": true },
    "ankylosauria:ankylosauria-antarctopelta-incubating": { "chainSeed": true },
    "ankylosauria:ankylosauria-struthiosaurus-incubating": { "chainSeed": true }

  }
}
