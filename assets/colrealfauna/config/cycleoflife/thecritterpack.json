    "thecritterpack:robin_flying": {
      "bodyWeight": 0.02, "growthRate": 0.9, "predationVulnerability": 0.9,
      "lifecycle": { "lifespanDays": 700, "gestationDays": 14, "litterSizeMin": 3, "litterSizeMax": 5, "breedingMonths": [4, 5, 6], "juvenileMortality": 0.75 }
