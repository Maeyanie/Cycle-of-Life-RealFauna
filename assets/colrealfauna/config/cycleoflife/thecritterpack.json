    "thecritterpack:bird-crow-adult": {
      "bodyWeight": 0.5, "growthRate": 0.3, "predationVulnerability": 0.5,
      "lifecycle": { "lifespanDays": 5000, "gestationDays": 20, "litterSizeMin": 3, "litterSizeMax": 5, "breedingMonths": [4, 5], "juvenileMortality": 0.6 }
    },
    "thecritterpack:crow_flying": {
      "bodyWeight": 0.5, "growthRate": 0.3, "predationVulnerability": 0.5,
