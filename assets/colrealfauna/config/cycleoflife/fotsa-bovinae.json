    "bovinae:bovinae-pseudoryxnghetinhensis":  { "carryingCapacity": 2, "growthRate": 0.15, "predationVulnerability": 0.6, "lifecycle": { "lifespanDays": 4300, "gestationDays": 230, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } }

