    "bovinae:bovinae-tragelaphusangasii":      { "carryingCapacity": 6, "growthRate": 0.32, "predationVulnerability": 0.75, "lifecycle": { "lifespanDays": 4300, "gestationDays": 225, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphusimberbis":     { "carryingCapacity": 6, "growthRate": 0.32, "predationVulnerability": 0.8, "lifecycle": { "lifespanDays": 4300, "gestationDays": 230, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    // The two bushbucks: small, solitary, and the staple prey of every mid-sized African predator.
    "bovinae:bovinae-tragelaphusscriptus":     { "carryingCapacity": 6, "growthRate": 0.38, "predationVulnerability": 0.85, "lifecycle": { "lifespanDays": 4300, "gestationDays": 180, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphussylvaticus":   { "carryingCapacity": 6, "growthRate": 0.38, "predationVulnerability": 0.85, "lifecycle": { "lifespanDays": 4300, "gestationDays": 180, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },

    // ===================== ODD ONES OUT =====================
    // Nilgai: the big Asian antelope, and one of the very few bovines that routinely twins.
    "bovinae:bovinae-boselaphustragocamelus":  { "carryingCapacity": 4, "growthRate": 0.35, "predationVulnerability": 0.65, "lifecycle": { "lifespanDays": 4500, "gestationDays": 245, "litterSizeMin": 1, "litterSizeMax": 2, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    // Four-horned antelope: 20 kg, the smallest bovine here, twins often, and short-lived to match.
    "bovinae:bovinae-tetracerusquadricornis":  { "carryingCapacity": 6, "growthRate": 0.45, "predationVulnerability": 0.9, "lifecycle": { "lifespanDays": 3600, "gestationDays": 245, "litterSizeMin": 1, "litterSizeMax": 2, "breedingMonths": [4, 5], "juvenileMortality": 0.55 } },
    // Saola: barely known to science and one of the rarest large mammals alive. Kept at the K of a
