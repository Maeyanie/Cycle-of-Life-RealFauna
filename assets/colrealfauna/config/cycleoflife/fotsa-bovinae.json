    "bovinae:bovinae-bubalusdepressicornis": { "carryingCapacity": 4, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 7000, "gestationDays": 300, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-bubalusquarlesi":       { "carryingCapacity": 4, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 7000, "gestationDays": 300, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-bubalusgrovesi":        { "carryingCapacity": 4, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 7000, "gestationDays": 300, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-bubaluscebuensis":      { "carryingCapacity": 4, "growthRate": 0.25, "predationVulnerability": 0.55, "lifecycle": { "lifespanDays": 6500, "gestationDays": 290, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },

    // ===================== ELANDS (Taurotragus) =====================
    // The largest antelope alive — eland bulls outweigh a horse — but far more nervous than a
    // buffalo, and they run rather than fight, so they are taken more often than their size suggests.
    "bovinae:bovinae-taurotragusderbianus": { "carryingCapacity": 2, "growthRate": 0.2, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 6500, "gestationDays": 270, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-taurotragusoryx":      { "carryingCapacity": 2, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 6500, "gestationDays": 270, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },

    // ===================== SPIRAL-HORNED ANTELOPE (Tragelaphus) =====================
    // Browsers, mostly solitary or in very small parties, one calf hidden for its first weeks.
    "bovinae:bovinae-tragelaphuseurycerus":    { "carryingCapacity": 3, "growthRate": 0.25, "predationVulnerability": 0.6, "lifecycle": { "lifespanDays": 6500, "gestationDays": 285, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphusbuxtoni":      { "carryingCapacity": 4, "growthRate": 0.25, "predationVulnerability": 0.6, "lifecycle": { "lifespanDays": 5400, "gestationDays": 275, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphusstrepsiceros": { "carryingCapacity": 4, "growthRate": 0.28, "predationVulnerability": 0.65, "lifecycle": { "lifespanDays": 5400, "gestationDays": 255, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    // Sitatunga: the swamp antelope. Splayed hooves for reed beds — the mod spawns it on land like
