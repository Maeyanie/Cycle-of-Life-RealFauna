// Cycle of Life: Realistic Fauna — FotSA cattle, buffalo & antelope (Bovinae).
//
// 26 Holocene bovines: the aurochs, the wild buffaloes (including a shelf of extinct dwarf and giant
// forms), the elands, the spiral-horned tragelaphine antelopes, and the saola. Diets and body
// weights come free and are excellent — the mod declares creatureDietByType (so elands and
// tragelaphines resolve as Fruit/Grain/Vegetable browsers and the buffalo as Grain/Vegetable
// grazers) and per-species, per-sex weights from a 20 kg four-horned antelope to a 1200 kg giant
// buffalo. Nothing to exclude: every spawn block is air/soil/sand/grass with no water in it, so even
// the swamp-dwelling sitatunga places safely on land.
//
// ---------------------------------------------------------------------------------------------
// WHAT K ACTUALLY MEANS, AND WHY THESE NUMBERS ARE SMALL
//
// carryingCapacity is NOT a herd size. The founding check compares it against every animal of the
// species within 6 chunks — a 13x13 block of chunks, which at 32 m per chunk is 0.173 km². So K is
// a POPULATION DENSITY: K animals per 0.173 km², i.e. K / 0.173 per km². K=1 is ~6 animals/km²,
// K=2 ~12, K=6 ~35, and the K=40 this mod would otherwise fall back to is ~231 animals/km².
//
// That makes K derivable from real biology rather than guessed, so it is derived here:
//     K = round(typical wild density per km² x 0.173), floored at 1.
// Cape buffalo run about 5-15/km² in good savanna (4.3/km² measured in Chebera Churchura), which
// gives K=2. Most of the rest are sparser animals — eland, kudu, bongo and aurochs all sit near or
// below 1/km² in the wild — so they land on the floor of 1. The thicket antelope are the exception:
// bushbuck and nyala genuinely reach 5-26/km², and sitatunga far more in papyrus, so those get 2-3.
//
// A caveat worth stating, because it changes how much any of this matters: for HERD species the K
// gate is effectively inert. A single unit grown to MaxHerdSize already exceeds any of these values
// on its own — one 20-strong buffalo herd is 231 animals/km² inside that window whatever K says — so
// no second unit founds nearby regardless, and what really sets the density you see is HERD SIZE and
// territory spacing. K binds only on the solitary and small-group species, which is exactly where
// these numbers do the work. (The grid also imposes a floor: a solitary species still needs a
// breeding PAIR in one place, and 2 animals in 0.173 km² is ~12/km² however sparse the real animal.)
//
// HERD SIZES are the genuinely biological number here, and the mod already gets them right almost
// everywhere — solitary bushbuck and anoa, 20-strong Cape buffalo herds with solitary bulls, small
// bongo parties. Those are inherited untouched. Four are overridden below where the mod is more
// gregarious than the animal: the four-horned antelope and the saola are solitary, the sitatunga
// nearly so, and greater kudu cows run in twos and threes rather than in teens.
// ---------------------------------------------------------------------------------------------
//
// Territories are opted in separately in territories.json — without them these hold no home range
// and spread evenly to K across every suitable cell.
//
// Lifecycles: bovines are slow. One calf, a gestation of eight to eleven months, and a long life.
// Only the nilgai and the four-horned antelope regularly twin. predationVulnerability scales
// inversely with size and temper — a Cape buffalo kills lions, a bushbuck is eaten by everything.
//
// VERIFICATION STATUS: keys derived from the mod's own entity JSON, not read off a live roster —
// this mod is not installed on the pack author's server. A wrong key is inert (the entry is ignored
// and the animal keeps its auto-discovered values); `/col species` lists the authoritative keys.
{
  "species": {

    // ===================== AUROCHS =====================
    // The wild ox: 800 kg bulls, ancestor of every cow. Wild cattle sit near 1/km² (European bison
    // in Białowieża are 0.5-2), so K floors at 1. Cattle-like gestation, one calf, long-lived.
    "bovinae:bovinae-bosprimigeniusprimigenius": { "carryingCapacity": 1, "growthRate": 0.18, "predationVulnerability": 0.3, "lifecycle": { "lifespanDays": 7200, "gestationDays": 283, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },

    // ===================== TRUE BUFFALO (Bubalus, Syncerus) =====================
    // Big, herd-forming, and dangerous — a healthy adult buffalo is close to unkillable for anything
    // but a lion pride, hence the very low vulnerability on the large ones. Gestation runs longer
    // than cattle (ten to eleven months in the water buffaloes). Cape buffalo are the densest bovine
    // here at 5-15/km²; the rest, and all the extinct forms, are modelled as sparser woodland game.
    "bovinae:bovinae-synceruscaffer":        { "carryingCapacity": 2, "growthRate": 0.18, "predationVulnerability": 0.25, "lifecycle": { "lifespanDays": 7200, "gestationDays": 340, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },
    "bovinae:bovinae-bubalusarnee":          { "carryingCapacity": 1, "growthRate": 0.16, "predationVulnerability": 0.25, "lifecycle": { "lifespanDays": 9000, "gestationDays": 320, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },
    "bovinae:bovinae-syncerusantiquus":      { "carryingCapacity": 1, "growthRate": 0.12, "predationVulnerability": 0.2, "lifecycle": { "lifespanDays": 9000, "gestationDays": 345, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },
    "bovinae:bovinae-bubalusmephistopheles": { "carryingCapacity": 1, "growthRate": 0.18, "predationVulnerability": 0.3, "lifecycle": { "lifespanDays": 7200, "gestationDays": 320, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },
    "bovinae:bovinae-bubalusmurrensis":      { "carryingCapacity": 1, "growthRate": 0.18, "predationVulnerability": 0.3, "lifecycle": { "lifespanDays": 7200, "gestationDays": 320, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },
    "bovinae:bovinae-bubalusbrevicornis":    { "carryingCapacity": 1, "growthRate": 0.2, "predationVulnerability": 0.35, "lifecycle": { "lifespanDays": 7000, "gestationDays": 310, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },
    "bovinae:bovinae-syncerusnanus":         { "carryingCapacity": 1, "growthRate": 0.2, "predationVulnerability": 0.35, "lifecycle": { "lifespanDays": 7200, "gestationDays": 340, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },

    // ---- Anoa, tamaraw and the dwarf island buffaloes: buffalo biology in a 100-240 kg body, and
    // solitary rather than herd-forming (the mod already gives them a group size of ~2, which is
    // right). Island endemics at 1-3/km², so K floors at 1. Long-lived for their size, one calf. ----
    "bovinae:bovinae-bubalusmindorensis":    { "carryingCapacity": 1, "growthRate": 0.2, "predationVulnerability": 0.4, "lifecycle": { "lifespanDays": 7000, "gestationDays": 300, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.4 } },
    "bovinae:bovinae-bubalusdepressicornis": { "carryingCapacity": 1, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 7000, "gestationDays": 300, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-bubalusquarlesi":       { "carryingCapacity": 1, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 7000, "gestationDays": 300, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-bubalusgrovesi":        { "carryingCapacity": 1, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 7000, "gestationDays": 300, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-bubaluscebuensis":      { "carryingCapacity": 1, "growthRate": 0.25, "predationVulnerability": 0.55, "lifecycle": { "lifespanDays": 6500, "gestationDays": 290, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },

    // ===================== ELANDS (Taurotragus) =====================
    // The largest antelope alive — eland bulls outweigh a horse — but far more nervous than a
    // buffalo, and they run rather than fight, so they are taken more often than their size suggests.
    // Both run at roughly 0.5-2/km² in the wild, so both floor at K=1.
    "bovinae:bovinae-taurotragusoryx":      { "carryingCapacity": 1, "growthRate": 0.22, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 6500, "gestationDays": 270, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },
    "bovinae:bovinae-taurotragusderbianus": { "carryingCapacity": 1, "growthRate": 0.2, "predationVulnerability": 0.5, "lifecycle": { "lifespanDays": 6500, "gestationDays": 270, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.45 } },

    // ===================== SPIRAL-HORNED ANTELOPE (Tragelaphus) =====================
    // Browsers of thicket and forest edge, one calf hidden for its first weeks. The thicket species
    // are the densest animals in this file — bushbuck and nyala genuinely reach 5-26/km² in riverine
    // cover — while the forest and montane ones are sparse.
    "bovinae:bovinae-tragelaphuseurycerus":    { "carryingCapacity": 1, "growthRate": 0.25, "predationVulnerability": 0.6, "lifecycle": { "lifespanDays": 6500, "gestationDays": 285, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphusbuxtoni":      { "carryingCapacity": 1, "growthRate": 0.25, "predationVulnerability": 0.6, "lifecycle": { "lifespanDays": 5400, "gestationDays": 275, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphusimberbis":     { "carryingCapacity": 1, "growthRate": 0.32, "predationVulnerability": 0.8, "lifecycle": { "lifespanDays": 4300, "gestationDays": 230, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    // Greater kudu: the mod groups cows 13 to a herd, which is a rutting-season aggregation rather
    // than a normal party — kudu cows run in twos and threes with their calves, bulls alone.
    "bovinae:bovinae-tragelaphusstrepsiceros": { "carryingCapacity": 1, "growthRate": 0.28, "predationVulnerability": 0.65, "herd": { "maxHerdSize": 10, "preferredHerdSize": 4 }, "lifecycle": { "lifespanDays": 5400, "gestationDays": 255, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    // Sitatunga: the swamp antelope, splay-hoofed for reed beds. Solitary or in twos, not the party
    // of six the mod gives it — but genuinely dense where papyrus is thick, hence K=3.
    "bovinae:bovinae-tragelaphusspekii":       { "carryingCapacity": 3, "growthRate": 0.3, "predationVulnerability": 0.65, "herd": { "maxHerdSize": 4, "preferredHerdSize": 2 }, "lifecycle": { "lifespanDays": 5000, "gestationDays": 245, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphusangasii":      { "carryingCapacity": 2, "growthRate": 0.32, "predationVulnerability": 0.75, "lifecycle": { "lifespanDays": 4300, "gestationDays": 225, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    // The two bushbucks: solitary (the mod has this right), and the staple prey of every mid-sized
    // African predator. The densest bovine here despite living alone.
    "bovinae:bovinae-tragelaphusscriptus":     { "carryingCapacity": 2, "growthRate": 0.38, "predationVulnerability": 0.85, "lifecycle": { "lifespanDays": 4300, "gestationDays": 180, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    "bovinae:bovinae-tragelaphussylvaticus":   { "carryingCapacity": 2, "growthRate": 0.38, "predationVulnerability": 0.85, "lifecycle": { "lifespanDays": 4300, "gestationDays": 180, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },

    // ===================== ODD ONES OUT =====================
    // Nilgai: the big Asian antelope, and one of the very few bovines that routinely twins.
    "bovinae:bovinae-boselaphustragocamelus":  { "carryingCapacity": 1, "growthRate": 0.35, "predationVulnerability": 0.65, "lifecycle": { "lifespanDays": 4500, "gestationDays": 245, "litterSizeMin": 1, "litterSizeMax": 2, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } },
    // Four-horned antelope: 20 kg, the smallest bovine here, twins often, short-lived to match —
    // and solitary, so the mod's group of four is overridden to a pair at most.
    "bovinae:bovinae-tetracerusquadricornis":  { "carryingCapacity": 1, "growthRate": 0.45, "predationVulnerability": 0.9, "herd": { "maxHerdSize": 2, "preferredHerdSize": 1 }, "lifecycle": { "lifespanDays": 3600, "gestationDays": 245, "litterSizeMin": 1, "litterSizeMax": 2, "breedingMonths": [4, 5], "juvenileMortality": 0.55 } },
    // Saola: barely known to science, one of the rarest large mammals alive, and solitary or in
    // pairs rather than the group of four the mod gives it. Real density is far below anything this
    // grid can express, so it sits on the K floor and stays a genuine event to meet.
    "bovinae:bovinae-pseudoryxnghetinhensis":  { "carryingCapacity": 1, "growthRate": 0.15, "predationVulnerability": 0.6, "herd": { "maxHerdSize": 2, "preferredHerdSize": 1 }, "lifecycle": { "lifespanDays": 4300, "gestationDays": 230, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.5 } }

  }
}
