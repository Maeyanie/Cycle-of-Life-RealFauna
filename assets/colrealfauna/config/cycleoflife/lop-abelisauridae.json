    // hitbox in the family, which agrees.
    "abelisauridae:abelisauridae-pycnonemosaurus": {
      "carryingCapacity": 1, "bodyWeight": 3400, "isPredator": true,
      "preyMinBodyWeight": 30, "preyMaxBodyWeight": 7000, "preyPerPredator": 10,
      "growthRate": 0.06, "predationVulnerability": 0.02,
      "lifecycle": { "lifespanDays": 13000, "gestationDays": 70, "litterSizeMin": 2, "litterSizeMax": 6, "breedingMonths": [4, 5], "juvenileMortality": 0.85 }
    },

