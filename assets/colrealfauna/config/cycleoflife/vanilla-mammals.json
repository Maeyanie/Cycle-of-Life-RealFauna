// Cycle of Life: Realistic Fauna — base-game mammals.
//
// "Real-but-playable" tuning. Values lean on real-world biology, scaled to game time. With 30-day
// months (~360 game-days/year) the lifespans below are roughly literal (e.g. 8000d ≈ 22 years).
// Lifecycles are deliberately slow: long lives, modest litters, seasonal births, so a hunted-out
// area recovers slowly and overhunting has consequences.
//
// Only fields that differ from auto-discovery are set; maturityDays is left to the auto-detected
// grow-chain value (overlays merge lifecycle fields). breedingMonths = the months young are BORN
// (1=Jan..12=Dec); gestationDays caps how often a female can give birth. preyPerPredator is only
// meaningful for predators (0 = an omnivore that won't starve for lack of meat).
//
// NOT touched here: carryingCapacity. Vanilla deer/goats carry a high per-chunk K (deer K=12) — a
// density/gameplay lever better tuned by observation than by biology, so it's left alone for now.
{
  "species": {

    // ===================== BEARS (apex/omnivore, slow breeders, den-raised cubs) =====================
    "game:bear-black": {
      "preyPerPredator": 0,                  // omnivore — forage/berries, doesn't depend on meat
      "predationVulnerability": 0.07,
      "growthRate": 0.12,
      "isForager": true, "foodCategories": ["Fruit", "Vegetable"],   // omnivore — berries, roots; now actually forages
      "lifecycle": {
        "lifespanDays": 7200, "gestationDays": 220,
        "litterSizeMin": 1, "litterSizeMax": 3,
        "breedingMonths": [1], "juvenileMortality": 0.35
      }
    },
    "game:bear-brown": {
      "preyPerPredator": 0,
      "predationVulnerability": 0.05,
      "growthRate": 0.1,
      "isForager": true, "foodCategories": ["Fruit", "Vegetable"],   // omnivore — berries, roots, tubers
      "lifecycle": {
        "lifespanDays": 8000, "gestationDays": 220,
        "litterSizeMin": 1, "litterSizeMax": 3,
        "breedingMonths": [1], "juvenileMortality": 0.35
      }
    },
    "game:bear-polar": {
      "preyPerPredator": 2.5,                // a true carnivore — will struggle outside the ice (realistic)
      "predationVulnerability": 0.04,
      "growthRate": 0.08,
      "lifecycle": {
        "lifespanDays": 9000, "gestationDays": 240,
        "litterSizeMin": 1, "litterSizeMax": 2,
        "breedingMonths": [1], "juvenileMortality": 0.45
      }
    },
    "game:bear-panda": {
      // bamboo specialist. Vanilla tags every bear "predator", so override it off; it forages the
      // Vegetable category (closest fit for bamboo) so its density is capped by overgrazing.
      "isPredator": false,
      "predationVulnerability": 0.1,
      "growthRate": 0.08,
      "isForager": true, "foodCategories": ["Vegetable"],   // bamboo
      "lifecycle": {
        "lifespanDays": 7000, "gestationDays": 140,
        "litterSizeMin": 1, "litterSizeMax": 1,
        "breedingMonths": [8], "juvenileMortality": 0.45
      }
    },
    "game:bear-sun": {
      // smallest bear, frugivore (keeps its auto [forage:Fruit])
      "predationVulnerability": 0.12,
      "growthRate": 0.15,
      "lifecycle": {
        "lifespanDays": 6500, "gestationDays": 95,
        "litterSizeMin": 1, "litterSizeMax": 2,
        "breedingMonths": [4], "juvenileMortality": 0.35
      }
    },

