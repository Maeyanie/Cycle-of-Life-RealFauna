    // king penguin - a fourteen-month breeding cycle, so a pair rears at most two chicks every three years
    "spheniscidae:spheniscidae-aptenodytespatagonicus": { "growthRate": 0.15, "predationVulnerability": 0.3, "lifecycle": { "lifespanDays": 7200, "gestationDays": 54, "litterSizeMin": 1, "litterSizeMax": 1, "breedingMonths": [4, 5], "juvenileMortality": 0.65 } },

