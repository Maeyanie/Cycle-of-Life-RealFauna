// Cycle of Life: Realistic Fauna — Primitive Survival.
//
// This mod carries no entity tags, so auto-detection can't read habitat/predator from it. Handle the
// creatures explicitly.
//
// IMPORTANT: the snakes + black rat have REAL (if rare) ambient spawn conditions — hot, dry,
// low-forest surface, maxQuantity 1. Excluding them would just hand those conditions back to the
// mod's spawner, which keeps rolling until every qualifying desert chunk fills — so they'd become
// COMMON there, not absent. So we MANAGE them and keep them rare ourselves (their maxQuantity 1 -> K=1).
// They're left non-predators: untagged, and a viper "hunting" the whole huntable herbivore list would
// be nonsense. Rare ambient desert fauna, nothing more.
//
// The bairdi crab + bioluminescent jellies ARE excluded — they're aquatic (insideBlockCodes water-*).
// We place on land, so managing them would veto the mod's water spawns and then fail to place our own,
// erasing them; excluding leaves them to the mod in the water where they belong. Land crab (terrestrial)
// is kept and tuned.
{
  "exclude": [
    "primitivesurvival:bairdicrab",
    "primitivesurvival:bioluminescent-*"
  ],
  "species": {

    // ---- Snakes (rare desert ambient, capped at K=1) ----
    "primitivesurvival:pitviper": {
      "growthRate": 0.4, "predationVulnerability": 0.6,
      "lifecycle": { "lifespanDays": 2500, "gestationDays": 100, "litterSizeMin": 2, "litterSizeMax": 4, "breedingMonths": [6, 7], "juvenileMortality": 0.6 }
    },
    "primitivesurvival:chainviper": {
      "growthRate": 0.4, "predationVulnerability": 0.6,
      "lifecycle": { "lifespanDays": 2500, "gestationDays": 100, "litterSizeMin": 2, "litterSizeMax": 4, "breedingMonths": [6, 7], "juvenileMortality": 0.6 }
    },
    "primitivesurvival:coachwhip": {
      // non-venomous, fast egg-layer
      "growthRate": 0.45, "predationVulnerability": 0.6,
      "lifecycle": { "lifespanDays": 2500, "gestationDays": 70, "litterSizeMin": 2, "litterSizeMax": 5, "breedingMonths": [6], "juvenileMortality": 0.65 }
    },

    // ---- Black rat (rare, prolific but capped at K=1) ----
    "primitivesurvival:blackrat": {
      "growthRate": 0.6, "predationVulnerability": 0.8,
      "lifecycle": { "lifespanDays": 900, "gestationDays": 22, "litterSizeMin": 3, "litterSizeMax": 6, "breedingMonths": [4, 5, 6, 7, 8], "juvenileMortality": 0.6 }
    },

    // ---- Land crab (terrestrial population) ----
    "primitivesurvival:landcrab": {
      "growthRate": 0.4, "predationVulnerability": 0.6,    // small, but shelled
      "lifecycle": { "lifespanDays": 1500, "gestationDays": 40, "litterSizeMin": 2, "litterSizeMax": 5, "breedingMonths": [5, 6], "juvenileMortality": 0.6 }
    }
  }
}
